# Local Postgres (see `docker-compose.yml`)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/vp?schema=public"

# Media (Cloudflare R2 behind a CDN/custom domain)
MEDIA_BASE_URL="https://cdn.example.com"

# Modelslab API Keys (AI Chat, Text to Speech, etc.)
# Support multiple keys for rate limit management.
# Add keys as MODELSLAB_API_KEY_1, MODELSLAB_API_KEY_2, etc.
# The system will rotate through available keys automatically.
MODELSLAB_API_KEY_1=""
MODELSLAB_API_KEY_2=""
MODELSLAB_API_KEY_3=""

# Socket.IO Server (for real-time direct messaging)
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# App URL (used for OAuth redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# Webhooks (for async AI generation callbacks)
# ============================================
# When set, ModelsLab will call back to YOUR_URL/api/webhooks/modelslab when
# image/video/audio generation jobs finish. This enables real-time job updates
# via SSE instead of blocking server-side polling.
#
# DEPLOYMENT CHECKLIST:
#   1. Set this to your public deployment URL (no trailing slash)
#      Example: WEBHOOK_BASE_URL="https://yourapp.vercel.app"
#   2. Ensure /api/webhooks/modelslab is accessible (no auth wall)
#   3. The webhook handler is already implemented at src/app/api/webhooks/[provider]/route.ts
#
# LOCAL DEV:
#   - Leave empty. Webhooks won't work on localhost (ModelsLab can't reach you).
#   - The system falls back to server-side polling automatically.
#   - If you need webhooks locally, use ngrok: WEBHOOK_BASE_URL="https://xxxx.ngrok.io"
#
# VERCEL:
#   - If not set, falls back to VERCEL_URL (auto-set by Vercel).
WEBHOOK_BASE_URL=""

# ============================================
# Authentication (JWT)
# ============================================
# Generate secure secrets with: openssl rand -base64 32
JWT_SECRET="change-this-to-a-secure-random-string"
JWT_REFRESH_SECRET="change-this-to-another-secure-random-string"

# ============================================
# OAuth Providers (optional - leave empty to disable)
# ============================================

# Google OAuth
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Discord OAuth
# https://discord.com/developers/applications
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Twitter/X OAuth
# https://developer.twitter.com/en/portal/projects
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# Apple Sign In
# https://developer.apple.com/account/resources/identifiers
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

